# Doxygen configuration for the vr package.
#
# Generates the C++ API reference from include/ alongside the hand-written guides in docs/.
# The guides are also readable as plain markdown on GitHub, which is why they use relative
# links rather than @ref everywhere: Doxygen resolves those to the generated pages.

PROJECT_NAME           = "vr"
PROJECT_NUMBER         = @PROJECT_VERSION@
PROJECT_BRIEF          = "MuJoCo worlds and headset input on a VIVE Focus Vision, over ROS 2"
PROJECT_LOGO           =

OUTPUT_DIRECTORY       = @CMAKE_CURRENT_BINARY_DIR@/docs
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = YES
OUTPUT_LANGUAGE        = English

INPUT                  = @VR_DOXYGEN_SOURCE_ROOT@/include \
                         @VR_DOXYGEN_DOCS_ROOT@/README.md \
                         @VR_DOXYGEN_DOCS_ROOT@/docs/index.md \
                         @VR_DOXYGEN_DOCS_ROOT@/docs/install.md \
                         @VR_DOXYGEN_DOCS_ROOT@/docs/run.md \
                         @VR_DOXYGEN_DOCS_ROOT@/docs/interfaces.md \
                         @VR_DOXYGEN_DOCS_ROOT@/docs/configuration.md \
                         @VR_DOXYGEN_DOCS_ROOT@/docs/unity.md \
                         @VR_DOXYGEN_DOCS_ROOT@/docs/embedding.md \
                         @VR_DOXYGEN_DOCS_ROOT@/docs/bringup.md \
                         @VR_DOXYGEN_DOCS_ROOT@/docs/testing.md \
                         @VR_DOXYGEN_DOCS_ROOT@/docs/design.md \
                         @VR_DOXYGEN_DOCS_ROOT@/docs/limits.md

RECURSIVE              = YES
EXCLUDE_PATTERNS       = */build/* */install/* */log/*
USE_MDFILE_AS_MAINPAGE = @VR_DOXYGEN_DOCS_ROOT@/README.md

# The components are not a public API: they are loaded by name, not linked against. The public
# surface is the embeddable publisher and the glTF/tessellation helpers in include/.
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES
TOC_INCLUDE_HEADINGS   = 3
AUTOLINK_SUPPORT       = YES
SORT_MEMBER_DOCS       = NO

QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_NO_PARAMDOC       = NO

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO
HTML_COLORSTYLE        = LIGHT
HTML_DYNAMIC_SECTIONS  = YES
SEARCHENGINE           = YES

GENERATE_LATEX         = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO

HAVE_DOT               = NO
