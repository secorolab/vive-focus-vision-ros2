# Doxygen configuration for the vive_vr_ros2 package.
#
# Generates the C++ API reference from include/ alongside the hand-written guides in docs/.
# The guides are also readable as plain markdown on GitHub, which is why they use relative
# links rather than @ref everywhere: Doxygen resolves those to the generated pages.

PROJECT_NAME           = "vive_vr_ros2"
PROJECT_NUMBER         = @VIVE_VR_VERSION@
PROJECT_BRIEF          = "MuJoCo worlds and headset input on a VIVE Focus Vision, over ROS 2"
PROJECT_LOGO           =

OUTPUT_DIRECTORY       = @CMAKE_CURRENT_BINARY_DIR@/docs
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = YES
OUTPUT_LANGUAGE        = English

# docs/index.md is the entry point when reading the guides on GitHub; here README.md is already
# the main page and the two would appear as duplicate nodes in the tree.
INPUT                  = @VIVE_VR_ROOT@/include \
                         @VIVE_VR_ROOT@/README.md \
                         @VIVE_VR_ROOT@/docs/install.md \
                         @VIVE_VR_ROOT@/docs/run.md \
                         @VIVE_VR_ROOT@/docs/interfaces.md \
                         @VIVE_VR_ROOT@/docs/configuration.md \
                         @VIVE_VR_ROOT@/docs/unity.md \
                         @VIVE_VR_ROOT@/docs/embedding.md \
                         @VIVE_VR_ROOT@/docs/bringup.md \
                         @VIVE_VR_ROOT@/docs/teleop.md \
                         @VIVE_VR_ROOT@/docs/testing.md \
                         @VIVE_VR_ROOT@/docs/design.md \
                         @VIVE_VR_ROOT@/docs/limits.md

RECURSIVE              = YES
EXCLUDE_PATTERNS       = */build/* */install/* */log/*
USE_MDFILE_AS_MAINPAGE = @VIVE_VR_ROOT@/README.md

# The components are not a public API: they are loaded by name, not linked against. The public
# surface is the embeddable publisher and the glTF/tessellation helpers in include/.
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES
TOC_INCLUDE_HEADINGS   = 3
AUTOLINK_SUPPORT       = YES
SORT_MEMBER_DOCS       = NO

QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_NO_PARAMDOC       = NO

# A broken @ref or a page missing from INPUT is otherwise a silent hole in the published site.
WARN_AS_ERROR          = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = html

# Same theme as the mj_kdl_wrapper docs: light/dark palettes in the stylesheet, switched by a
# toggle in the header. HTML_COLORSTYLE stays LIGHT because the stylesheet owns dark mode.
HTML_HEADER            = @VIVE_VR_ROOT@/docs/doxygen/custom/header.html
HTML_EXTRA_STYLESHEET  = @VIVE_VR_ROOT@/docs/doxygen/custom/vr-doxygen.css
HTML_EXTRA_FILES       = @VIVE_VR_ROOT@/docs/doxygen/custom/vr-doxygen.js

GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO
HTML_COLORSTYLE        = LIGHT
HTML_DYNAMIC_SECTIONS  = YES
SEARCHENGINE           = YES

GENERATE_LATEX         = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO

HAVE_DOT               = NO
