# ROS 2 / colcon
build/
install/
log/
compile_commands.json

# editor/tooling caches
.cache/

# Unity: generated, machine-specific, or huge
unity/VrRos/Library/
unity/VrRos/Temp/
unity/VrRos/Logs/
unity/VrRos/UserSettings/
unity/VrRos/Build/
unity/VrRos/.utmp/
unity/VrRos/*_BurstDebugInformation_DoNotShip/

# VIVE OpenXR UPM tarball, 361 MB: a redistributable release artefact, so it is a setup step.
# Run tools/fetch_vive_plugin.sh to get it.
unity/VrRos/vendor/

# TMP's own .unitypackage, unpacked by VrRosSetup.ImportTmpResources. It keeps its GUIDs across
# imports, so the scene's font reference survives without it being tracked here.
unity/VrRos/Assets/TextMesh Pro/
unity/VrRos/Assets/TextMesh Pro.meta

# exported scenes are build artefacts of scene_export
/tmp/vr_scene/
/tmp/vr_robot/

# Workspace dependencies, each its own git repo: copied in or cloned, never committed here.
# See README for where they come from.
src/mj_kdl_wrapper/
src/orocos_kinematics_dynamics/

# Generated by the Unity preview and live-editor tooling
unity/VrRos/Assets/ImportedScenes/
unity/VrRos/Assets/ImportedScenes.meta
unity/VrRos/Assets/Temp/
unity/VrRos/Assets/Temp.meta
